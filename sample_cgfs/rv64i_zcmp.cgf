cmmvsa01:
    config: 
      - check ISA:=regex(.*64.*I.*Zca.*Zcmp.*)
    mnemonics: 
      cm.mvsa01: 0
    rs1:
      <<: *sp8_regs
    rs2:
      <<: *sp8_regs
    op_comb:
      <<: *sfmt_op_comb
    val_comb:
      <<: [*crfmt_val_comb_sgn, *base_rs1val_sgn, *base_rs2val_sgn]
      abstract_comb:
        'sp_dataset(xlen)': 0
        <<: [*rs1val_walking,*rs2val_walking]

cmmva01s:
    config: 
      - check ISA:=regex(.*64.*I.*Zca.*Zcmp.*)
    mnemonics: 
      cm.mva01s: 0
    rs1:
      <<: *sp8_regs
    rs2:
      <<: *sp8_regs
    op_comb:
      <<: *sfmt_op_comb
    val_comb:
      <<: [*crfmt_val_comb_sgn, *base_rs1val_sgn, *base_rs2val_sgn]
      abstract_comb:
        'sp_dataset(xlen)': 0
        <<: [*rs1val_walking,*rs2val_walking]